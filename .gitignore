# Xcode — user-specific & build artifacts
## Build generated
build/
dist/
DerivedData/
*.o
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

## Various settings
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.xcuserstate
*.xcscmblueprint

## Xcode project — keep shared schemes, ignore user schemes
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
# Track Package.resolved (reproducible release builds), ignore other swiftpm state
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Packages/

# CocoaPods / Carthage (not used)
Pods/
Carthage/Build/

# Fastlane / signing
*.mobileprovision
*.provisionprofile
*.p12
*.cer

# Misc
*.swp
*~

# Editor / tooling metadata (local to one developer setup)
.idea/
.codenomad/
.vscode/

# Eval transcripts and traces; a trace of a live provider session can carry
# request URLs, and 60+ files per run do not belong in history.
eval/runs/
